{
  "name": "dsh-handeye",
  "version": "0.23.0",
  "description": "手眼合一（DSH 插件）：handeye 的手 + 屏幕投影 + UIA 后台控件 + 浏览器 CDP，加操作记忆、任务卡与安全门卫。",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test"
  },
  "os": [
    "win32"
  ],
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "he-server": "bin/he-server.js"
  },
  "files": [
    "src",
    "bin",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "handeye",
    "uia",
    "screen"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dove-pen/dsh-handeye.git"
  },
  "homepage": "https://github.com/dove-pen/dsh-handeye",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
