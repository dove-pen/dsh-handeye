{
  "name": "dsh-handeye",
  "version": "0.2.0",
  "description": "手眼合一（DSH 插件）：handeye 的手 + 杨镜的 L0/L1/L2 投影 + UIA 后台控件操作 + 浏览器 CDP 通道，合成一个插件。",
  "type": "module",
  "main": "src/index.js",
  "os": [
    "win32"
  ],
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "handeye",
    "uia",
    "screen"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
